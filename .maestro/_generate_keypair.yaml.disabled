appId: dev.fly.healthme
---
# Verify tapping Generate Keypair triggers key generation
- launchApp
- extendedWaitUntil:
    visible: "HealthMe"
    timeout: 30000
- extendedWaitUntil:
    visible: "Generate Keypair"
    timeout: 15000
- tapOn: "Generate Keypair"

# After generating, the app should navigate away from login
# Give extra time for crypto + session creation in CI
- extendedWaitUntil:
    visible: "Home"
    timeout: 45000
